# Database configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/onshape_visualizer"

# App settings
APP_BASE_URL="http://localhost:3000"

# OnShape API configuration (for production - not required in mock mode)
ONSHAPE_BASE_URL="https://platform.onshape.com"
ONSHAPE_AUTH_MODE="client_credentials" # or "oauth2"
ONSHAPE_ACCESS_KEY="" 
ONSHAPE_SECRET_KEY=""
ONSHAPE_CLIENT_ID=""
ONSHAPE_CLIENT_SECRET=""
ONSHAPE_REDIRECT_URI=""

# Asset storage (filesystem for dev, S3 for production)
ASSET_STORAGE_DRIVER="fs" # or "s3"  
ASSET_STORAGE_PATH="./storage/assets"

S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Webhook security
WEBHOOK_SECRET=""

# Authentication (dev only - use proper auth in production)
JWT_SECRET="your-jwt-secret-change-in-production"
